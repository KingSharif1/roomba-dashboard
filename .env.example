# Copy to .env.local. Never commit .env.local or API keys.

# Private Tailscale origin of the Pi FastAPI server.
# Server-only. The browser receives it only for the signed-in owner.
# Unset forces demo mode for everyone, including the owner.
ROBOT_URL=https://your-robot.your-tailnet.ts.net

# The one email allowed to control the real robot. Compared case-insensitively.
# Empty means nobody is the owner.
OWNER_EMAIL=owner@example.com

# Supabase project used for the owner sign-in (password or magic link).
# Without these, the dashboard stays in demo mode and /login explains that.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard: Authentication → URL configuration →
# add https://<your-domain>/auth/callback as a redirect URL.

# Claude Slack bot
# Slack app "Signing Secret" (Basic Information page). Used to verify requests.
SLACK_SIGNING_SECRET=
# Slack bot token (OAuth & Permissions page). Starts with xoxb-.
SLACK_BOT_TOKEN=xoxb-
# The bot's own Slack user id (e.g. U0123ABCD). Used for loop protection and to
# detect @-mentions. Find it via auth.test or the app's member profile.
SLACK_BOT_USER_ID=
# Anthropic API key for the Messages API (console.anthropic.com).
ANTHROPIC_API_KEY=
# Optional: override the Claude model id (defaults to the Opus model in code).
CLAUDE_MODEL=
