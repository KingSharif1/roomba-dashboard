# Copy to .env.local. Never commit .env.local or API keys.

# Private Tailscale origin of the Pi FastAPI server.
# Server-only. The browser receives it only for the signed-in owner.
# Unset forces demo mode for everyone, including the owner.
ROBOT_URL=https://roomba.tail297c20.ts.net

# The one email allowed to control the real robot. Compared case-insensitively.
# Empty means nobody is the owner.
OWNER_EMAIL=sharifahmed.dev@gmail.com

# Supabase project used for the owner sign-in (password or magic link).
# Without these, the dashboard stays in demo mode and /login explains that.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard: Authentication → URL configuration →
# add https://<your-domain>/auth/callback as a redirect URL.
