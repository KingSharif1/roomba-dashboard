# Copy to .env.local. Never commit real values.

# Private Tailscale origin of the Pi FastAPI server.
# Server-only. It is not sent to the browser unless the signed-in user is the owner.
# Example: https://roomba.<tailnet>.ts.net
# Leave unset to force demo mode for everyone, including the owner.
ROBOT_URL=

# Exactly one email address allowed to control the real robot.
# Compared case-insensitively. If this is empty, nobody is the owner.
OWNER_EMAIL=

# Supabase project used for the owner sign-in (password or magic link).
# Without these, the dashboard stays in demo mode and /login explains that.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard: Authentication → URL configuration →
# add https://<your-domain>/auth/callback as a redirect URL.
